-- ============================================================
-- 中文技能条目骨架
-- 落点：lang/zh_CN/Package/<LangFile>.lua（先 grep 确认正确文件，见 references/skill-classes.md）
-- 追加位置：放在该武将既有条目的同一段内，紧跟其武将名之后
-- ============================================================

	-- 若为新武将，需要先补上（如果还没有）：
	-- ["#{{general}}"] = "武将称号",
	-- ["illustrator:{{general}}"] = "画师",
	-- ["{{general}}"] = "武将中文名",

	["{{skillname}}"] = "{{技能中文名}}",
	[":{{skillname}}"] = "{{技能描述文本}}",

	-- 以下按需保留，不需要就删掉整行
	["@{{skillname}}"] = "是否发动“{{技能中文名}}”，{{操作提示}}",
	["~{{skillname}}"] = "{{操作指引，如：选择一张手牌→点击确定}}",
	["#{{SkillName}}Buff"] = "%from 的“<font color=\"yellow\"><b>{{技能中文名}}</b></font>”效果被触发，{{变化描述}}",

-- ============================================================
-- 文风约定（与项目现有条目保持一致）
--   ▶  表示"然后 / 其后结算"，衔接两个结算步骤
--   →  表示"选择操作"，用于 ~xxx 操作指引
--   【】标牌名，如【杀】【闪】
--   %arg / %arg2 / %from / %to / %src  日志占位符，配合 LogMessage 使用
--   X / Y  变量
--   锁定技、限定技、觉醒技 等关键词按技能实际性质写在描述开头
--   "你可以……" 表可选；"你须……" 表强制
-- ============================================================
